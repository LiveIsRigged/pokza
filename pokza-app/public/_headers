# En-têtes de sécurité HTTP — servis par Cloudflare avec les fichiers statiques
# =============================================================================
# Ce fichier est copié tel quel dans `dist/` par `expo export`, et Cloudflare l'applique aux
# réponses. Il n'y a pas de script Worker dans ce projet (cf. wrangler.jsonc) : c'est donc le
# seul endroit où poser des en-têtes.
#
# ✅ VÉRIFIÉ EN LIGNE LE 2026-08-23 : Cloudflare applique bien ce fichier. La CSP, `nosniff`,
# `X-Frame-Options`, `Permissions-Policy` et `Referrer-Policy` sortent tous sur les réponses de
# pokza.app, et la règle par chemin `/s/*` plus bas ne sort QUE sur ce chemin. Pas de Worker à
# écrire. Pour le revérifier après un changement d'hébergement :
#   curl -sI https://pokza.app | grep -i "content-security-policy\|x-content-type"

/*
  # ── Protections sans risque de casse ──────────────────────────────────────────────────
  # Empêche le navigateur de « deviner » un type de fichier autre que celui annoncé. Sans ça,
  # un fichier déposé dans le stockage et annoncé comme image peut être interprété comme du
  # script s'il en contient.
  X-Content-Type-Options: nosniff

  # Interdit d'afficher Pokza dans un cadre sur un autre site. C'est la protection contre le
  # détournement de clic : un site tiers superpose une page invisible de Pokza sous ses propres
  # boutons, et l'utilisateur exécute des actions sur son compte en croyant cliquer ailleurs.
  X-Frame-Options: DENY

  # Ne transmet jamais l'adresse complète de la page consultée aux sites tiers — un lien vers
  # une main partagée ne doit pas divulguer son identifiant à qui que ce soit.
  Referrer-Policy: strict-origin-when-cross-origin

  # Coupe les capteurs et interfaces que Pokza n'utilise pas. La caméra reste autorisée sur
  # l'origine elle-même : elle sert à scanner le code d'invitation d'un ami.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Force le HTTPS pendant un an. À n'activer qu'une fois certain que tout fonctionne en HTTPS,
  # car un navigateur qui a vu cet en-tête refusera le HTTP pendant toute cette durée.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Politique de sécurité du contenu — ACTIVE (bloque réellement) ──────────────────────
  # Elle a d'abord été déployée en `Report-Only` (signale sans bloquer), puis un parcours
  # complet de l'app a été fait console ouverte le 2026-08-15 : connexion, feed, commentaire
  # avec GIF, commentaire avec photo, changement d'avatar, ouverture d'un groupe, scanner de
  # code. **Zéro violation.** C'est ce constat, et lui seul, qui autorise le blocage.
  #
  # Deux violations avaient été trouvées et corrigées pendant l'observation :
  #   • le script PostHog, servi par `eu-assets.i.posthog.com` et non `eu.i.posthog.com` ;
  #   • le flux de la caméra, en `blob:` (ajout de `media-src`).
  #
  # ⚠️ SI QUELQUE CHOSE CASSE (page blanche, image absente, bouton sans effet) : rajouter
  # `-Report-Only` à la fin du nom de l'en-tête ci-dessous et redéployer. La protection est
  # alors désactivée, mais tout refonctionne immédiatement — et la console nommera le domaine
  # à ajouter. Ne jamais supprimer la ligne entière : on perdrait la trace de ce qui marche.
  #
  # Ce qui n'a PAS été parcouru pendant l'observation, et où une surprise reste possible :
  # la réinitialisation de mot de passe, les écrans d'administration, le formulaire public de
  # signalement (celui-ci est servi par Supabase, donc sur une autre origine — non concerné).
  #
  # Origines autorisées, et pourquoi :
  #   *.supabase.co            base de données, authentification, stockage des images
  #   *.giphy.com              les IMAGES des GIF, servies directement au navigateur. `api.giphy.com`
  #                            a été RETIRÉ de `connect-src` avec F-16 : la recherche passe
  #                            désormais par la fonction serveur `giphy`, donc par *.supabase.co.
  #                            Si la recherche de GIF cesse de fonctionner, le coupable est la
  #                            fonction ou son secret — surtout pas cette ligne, ne la rouvre pas.
  #   eu.i.posthog.com         analytics : envoi des évènements
  #   eu-assets.i.posthog.com  analytics : le SCRIPT lui-même, servi depuis un domaine DIFFÉRENT
  #                            du précédent. Constaté en observation sur le site en ligne le
  #                            2026-08-15 — l'oublier aurait cassé l'analytics en mode blocage.
  #   challenges.cloudflare.com  le CAPTCHA Turnstile — script ET cadre, les deux sont requis
  #
  # `media-src` couvre le flux vidéo de la caméra (scanner du code d'invitation d'un ami) :
  # selon la version d'expo-camera, il transite par une URL `blob:` que la politique refuserait
  # sinon. Aucune violation observée à ce jour — c'est une précaution, pas une correction.
  #
  # `style-src` autorise l'inline parce que react-native-web fabrique ses styles à l'exécution
  # et les injecte dans la page ; sans ça, l'app perd toute sa mise en forme. `script-src`, lui,
  # n'en a pas besoin : le build ne produit aucun script inline (vérifié dans dist/index.html),
  # ce qui rend cette politique réellement protectrice contre l'injection de code.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://*.giphy.com; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ── Liens de partage : hors des moteurs de recherche ──────────────────────────────────────
# `/s/:token` ouvre une main que son auteur a rendue partageable SANS la rendre publique. On ne
# peut pas empêcher un destinataire de faire suivre le lien — le secret est dans l'URL, et il n'y
# a pas de compte pour distinguer qui regarde. Mais « un pote l'a fait suivre à trois copains » et
# « ma main sort dans les résultats Google » ne sont pas du même ordre : le second se ferme ici.
#
# Un lien collé un jour sur un forum ou un Discord indexable serait sinon exploré et conservé.
# `/post/:id`, lui, n'est PAS couvert : une main publique a le droit d'être trouvée.
/s/*
  X-Robots-Tag: noindex, nofollow
