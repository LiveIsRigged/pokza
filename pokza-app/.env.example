# Copie ce fichier en .env et renseigne les valeurs depuis le dashboard Supabase
# (Project Settings > API). Ne jamais committer le .env réel.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GIPHY_API_KEY=

# Cloudflare Turnstile (CAPTCHA anti-robot sur inscription / connexion / mot de passe oublié).
# Clé PUBLIQUE du widget uniquement — la clé secrète, elle, se colle dans le dashboard Supabase
# (Authentication > Attack Protection) et ne doit JAMAIS apparaître ici.
# Laisser VIDE = CAPTCHA désactivé côté app. ⚠️ Si le CAPTCHA est activé côté projet Supabase et
# que cette clé est vide, plus personne ne peut se connecter : les deux vont ensemble.
# Clé de test qui réussit toujours (pour DEV) : 1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog (analytics web, RÉGION EU). Laisser VIDE = analytics dormant (aucune donnée envoyée).
# Renseigner le jour où on active l'analytics : Project API Key (phc_…) + host EU.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
